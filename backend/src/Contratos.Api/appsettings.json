{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "ContratosApi",
    "Audience": "ContratosApp",
    "ExpirationMinutes": 60
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "storage",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".doc",
      ".docx"
    ]
  },
  "Supabase": {
    "Url": "",
    "ServiceRoleKey": "",
    "StorageBucket": "contracts"
  },
  "Cors": {
    "FrontendUrl": "http://localhost:4200"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "EnableSensitiveDataLogging": false
  }
}
