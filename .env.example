# ============================================================
# Administracion y Control de Vigencia de Contratos
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# ============================================================

# ---- Base de datos (Supabase PostgreSQL) ----
# Usar el SESSION POOLER (puerto 5432). Motivos:
#   - Es compatible con IPv4 (la conexion directa de Supabase es solo IPv6).
#   - Mantiene la conexion durante toda la sesion, asi que admite prepared
#     statements y migraciones de EF Core sin conflictos.
#   - El transaction pooler (puerto 6543) reutiliza conexiones entre
#     transacciones y rompe los prepared statements con nombre.
#
# Dashboard de Supabase > Connect > Session pooler > .NET
# Formato:
#   Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;
#   Username=postgres.<project_ref>;Password=<password>;SSL Mode=Require;
#   Trust Server Certificate=true;Maximum Pool Size=20
#
# SSL Mode=Require es obligatorio: Supabase rechaza conexiones sin cifrar.
# Nunca usar SSL Mode=Disable ni desactivar la validacion de forma insegura.
ConnectionStrings__DefaultConnection=

# ---- Ajustes de EF Core (opcionales, tienen valores por defecto) ----
Database__CommandTimeoutSeconds=30
Database__MaxRetryCount=3
Database__MaxRetryDelaySeconds=10
# Solo en desarrollo: registra los parametros de las consultas en el log.
Database__EnableSensitiveDataLogging=false

# ---- JWT ----
# JWT_SECRET: minimo 32 caracteres aleatorios
Jwt__Secret=
Jwt__Issuer=ContratosApi
Jwt__Audience=ContratosApp
Jwt__ExpirationMinutes=60

# ---- Usuario administrador inicial (seed) ----
Seed__AdminUsername=admin
Seed__AdminPassword=
Seed__AdminFullName=Administrador

# ---- Almacenamiento de archivos ----
# Provider: Supabase | Local
Storage__Provider=Local
Storage__LocalPath=storage
Storage__MaxFileSizeBytes=10485760

# ---- Supabase Storage ----
Supabase__Url=
Supabase__ServiceRoleKey=
Supabase__StorageBucket=contracts

# ---- CORS ----
Cors__FrontendUrl=http://localhost:4200

# ---- Frontend ----
API_URL=http://localhost:5080/api
